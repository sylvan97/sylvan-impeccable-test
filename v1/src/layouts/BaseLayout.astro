---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sylvan — 沉淀的文字、影像与足迹',
  description = 'Sylvan 沉淀站。沉积的文字、影像与足迹。',
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-theme="field-notebook">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EFE8D5" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
