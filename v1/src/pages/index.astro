---
import BaseLayout from '../layouts/BaseLayout.astro';
import DynamicIsland from '../components/DynamicIsland.astro';
import '../styles/field-notebook.css';

const entries = [
  {
    number: '壹。',
    title: '文章',
    english: 'Reading',
    description: '关于城市、关于路、关于走过的地方。慢一点的文字。',
    stats: ['5 篇', '2024 — 至今'],
    href: '/articles',
  },
  {
    number: '贰。',
    title: '影像与足迹',
    english: 'Footprints',
    description: '旅记、相册、citywalk。文字与影像等权。',
    stats: ['3 旅', '1–2 年相册', '5 citywalk'],
    href: '/travels',
  },
];

const recent = [
  ['2026 · 03 · 14', '在武康路走一下午', '从淮海中路拐进去，梧桐刚刚落完叶，午后的光打在老房子上像慢曝光。我想这是 citywalk 教给我的事——不要赶，...'],
  ['2026 · 02 · 28', '夜里十一点的长乐路', '这家小书店还在。店主没抬头，把我要的那本从架子最上层抽下来递过来。城市里还有这种地方，是值得记下来的事。'],
  ['2026 · 01 · 19', '关于沉淀这件事', '为什么不发朋友圈？为什么写在这里？大概因为这里没有点赞——只有时间。'],
];
---

<BaseLayout>
  <DynamicIsland />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <span class="date-stamp">2026 · 春 · 第三本</span>
      <h1 id="hero-title" class="signature">Sylvan</h1>

      <div class="entries">
        {entries.map((entry) => (
          <article class="entry">
            <div class="num">{entry.number}</div>
            <h2>{entry.title}<em>— {entry.english}</em></h2>
            <p class="desc">{entry.description}</p>
            <div class="stats">
              {entry.stats.map((stat) => <span>{stat}</span>)}
            </div>
            <a class="cta" href={entry.href}>翻开</a>
          </article>
        ))}
      </div>
    </section>

    <section class="featured" id="featured" aria-labelledby="featured-title">
      <div class="featured-head">
        <h3 id="featured-title">近期 · 几篇</h3>
        <span class="sub">最近写下的三段</span>
      </div>

      {recent.map(([date, title, description]) => (
        <article class="article-row">
          <div class="date">{date}</div>
          <h4><a href="/articles">{title}</a></h4>
          <p>{description}</p>
        </article>
      ))}
    </section>
  </main>

  <footer>
    <span class="sign">— Sylvan.</span>
    <div class="small">© 2024 — 至今 · 这一本慢慢写</div>
  </footer>
</BaseLayout>
